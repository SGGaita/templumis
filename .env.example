# ============================================
# TemplumIS Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# PostgreSQL
POSTGRES_USER=templumis
POSTGRES_PASSWORD=Waxmangme86
POSTGRES_DB=templumis
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend (FastAPI)
BACKEND_SECRET_KEY=changeme_jwt_secret_key
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost
APP_BASE_URL=http://localhost:3000
BACKEND_DEBUG=true

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Email Configuration (Gmail SMTP)
# NOTE: SMTP_PASSWORD must be a Gmail App Password (not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
# Remove spaces from the app password before adding it here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=steveggaita@gmail.com
SMTP_PASSWORD=hkpdboqhbupmazka
FROM_EMAIL=TemplumIS <no-reply@templumis.org>

# Optional: Ahrefs API v3 token for live Webometrics Visibility (referring domains)
# Without this, Visibility still uses verified institution domains + HTTPS probe,
# but the Impact referring-domain count stays incomplete until the token is set.
# Get a token from https://app.ahrefs.com/api (Site Explorer access required)
AHREFS_API_TOKEN=
