# ============================================
# TemplumIS Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# PostgreSQL
POSTGRES_USER=templumis
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=templumis_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend (FastAPI)
BACKEND_SECRET_KEY=changeme_jwt_secret_key
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost
BACKEND_DEBUG=true

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
